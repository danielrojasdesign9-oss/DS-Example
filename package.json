{
  "name": "clickguard-brainstorm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck",
    "build:tokens": "node packages/ui/scripts/build-tokens.mjs",
    "storybook": "storybook dev -p 6006 --config-dir packages/ui/.storybook",
    "build:storybook": "storybook build -o storybook-static --config-dir packages/ui/.storybook",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "storybook": "^8.6.18",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "5.6.3",
    "vite": "^6.4.1",
    "vite-plugin-manus-runtime": "^0.0.58"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": { "overrides": { "tailwindcss>nanoid": "3.3.7" } }
}
